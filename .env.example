# Copiar a .env.local y completar. Nunca commitear valores reales (.env* está en .gitignore).

# Supabase. Las dos públicas van al navegador: URL y clave anon/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor: lee la allowlist y escribe el avance del video. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Visión para páginas escaneadas (sólo servidor).
VISION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Razonamiento del modelo: vacío = el de la API (high); "none" lo apaga (más barato, ver README).
VISION_REASONING=

# EXPERIMENTAL, NO PROBADO contra la API real. Sólo se usa con VISION_PROVIDER=gemini.
# En la cuota gratuita de Google AI Studio, Google puede usar las imágenes para mejorar sus productos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
