# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# copiado en postinstall
/public/pdf.worker.min.mjs

# Corrida de npm run muestras: cambia en cada ejecución.
/bench/samples-ultima.json

# Manual de estudio personal: no se sube (el repo es público).
/manual-mateo/

# Plano real de baja resolución: archivos locales, no se suben (el plano no es nuestro).
/samples/7-plano-real-limpio-control.pdf
/samples/8-plano-real-con-errores.pdf
/samples/9-plano-real-con-errores-x2-resolucion.pdf
/samples/esperados-planos-reales.json
/bench/crudas-*/
# Corridas con el plano real: traen los textos que leyó la IA, no se suben.
/bench/samples-reales-*.json
/bench/samples-prompt-*.json
