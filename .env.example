# Supabase (públicas: URL y clave anon/publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor
SUPABASE_SERVICE_ROLE_KEY=
# Visión (sólo servidor)
VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Gemini (Google AI Studio). Cuota gratuita: Google puede usar los datos para mejorar sus productos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Razonamiento del modelo de visión: vacío = por defecto (high); "none" lo apaga (ver README).
VISION_REASONING=
